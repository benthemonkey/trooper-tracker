# .env for the Midwest Garrison staging copy (copy to tracker-app/.env, chmod 600).
#
# Staging shares the live forum, members and 501st data. Rule: it may read, it must never
# write anywhere outside its own database. Every outbound integration below is off or read-only.
# Rebuilt nightly by deploy/staging/tt-staging-refresh.sh, which rewrites DB_DATABASE here.

APP_NAME='Troop Tracker (staging)'
# Not "production": that would enable exception emails. Never true for DEBUG: debug pages show member data.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://test.midwestgarrison.com
APP_TIMEZONE=America/Chicago
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

TRACKER_CALENDAR_TIMEZONE=America/Chicago
TRACKER_TENTATIVE_CUTOFF_DAYS=7
# Blank hides the monthly support-goal widget (Midwest has no forum donations set up)
TRACKER_SUPPORT_GOAL=
TRACKER_SUPPORT_URL=https://midwestgarrison.com/
TRACKER_DONOR_IMAGE_URL=''

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Staging-only DB user with rights on the two staging DBs and nothing else.
# DB_DATABASE is either mwg_tt_test_a or mwg_tt_test_b; the refresh script flips it.
DB_CONNECTION=mysql
DB_HOST=mysql.midwestgarrison.com
DB_PORT=3306
DB_DATABASE=mwg_tt_test_a
DB_USERNAME=mwg_tt_stage
DB_PASSWORD=CHANGE_ME

# File sessions and cache survive the A/B switch (trooper ids are identical across rebuilds).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Nobody gets mail from staging.
MAIL_MAILER=log
MAIL_FROM_ADDRESS='noreply@midwestgarrison.com'
MAIL_FROM_NAME='Troop Tracker (staging)'
MAIL_SUBJECT_PREFIX='[TT staging]'
CONTACT_EMAIL=
SUPPORT_URL=

# Login: a dedicated "Troop Tracker (staging)" OAuth2 client in the live forum's ACP.
TRACKER_REQUIRE_XENFORO=true
XENFORO_CLIENT_ID=CHANGE_ME
XENFORO_CLIENT_SECRET=CHANGE_ME
XENFORO_REDIRECT_URI=https://test.midwestgarrison.com/oauth/xenforo/callback
XENFORO_BASE_URL=https://midwestgarrison.com/forum
XENFORO_NAME='Midwest Garrison Forum'

# NO API KEY. The hourly user sync would rewrite members' forum profile fields and user
# groups, and event changes would post threads. Never give staging a key with write scopes.
# The read-only switch is a second guard in case a key is ever added.
XENFORO_API_KEY=
XENFORO_API_USER=
XENFORO_READ_ONLY=true
XENFORO_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional: set to test Blurrg auto-assignment from event addresses (read-only API).
GOOGLE_MAPS_API_KEY=

TRACKER_EXCEPTION_EMAIL_ENABLED=false
TRACKER_SUPERVISOR_EMAIL_ENABLED=false

DISCORD_WEBHOOK_URL=
POSTMARK_API_KEY=
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
