# Staging cron jobs. Adjust the PHP path to what `ls -d /usr/local/php8*` shows.
# The refresh prints only on failure, so the job's email arrives only then.
#
# DreamHost: create these in the panel (Advanced > Cron Jobs > Add New Cron Job), with
# "Use locking" on and "When to run: Custom". The panel allows at most 12 run times an hour, so
# the scheduler and queue run every 5 minutes, not every minute. Every scheduled task falls on
# a multiple of 5 minutes (see routes/console.php), so nothing is skipped; only the queue
# heartbeat ticks less often. Server time is Pacific: 2:00 there is 4:00 Central.
#
# Elsewhere, as crontab lines:
MAILTO=CHANGE_ME
TT=/home/CHANGE_ME/trooper-tracker
PHP=/usr/local/php84/bin/php

# Nightly rebuild from the live legacy DB (server time; check `date`)
0 2 * * * TT_PHP=$PHP $TT/deploy/staging/tt-staging-refresh.sh

# Laravel scheduler, and the queue (no supervisor on shared hosting)
*/5 * * * * cd $TT/tracker-app && $PHP artisan schedule:run >> /dev/null 2>&1
*/5 * * * * cd $TT/tracker-app && $PHP artisan queue:work --stop-when-empty --max-time=280 >> /dev/null 2>&1
